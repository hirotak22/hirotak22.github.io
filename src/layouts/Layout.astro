---
import type { SiteContent } from "../contents/types";

type PageKey = "home" | "publications" | "activities";

type Props = {
  content: SiteContent;
  activePage: PageKey;
};

const { content, activePage } = Astro.props;

const pagePaths: Record<PageKey, string> = {
  home: "",
  publications: "publications/",
  activities: "activities/",
};

const languageBase = content.language === "ja" ? "/" : "/en/";
const alternateBase = content.language === "ja" ? "/en/" : "/";
const getPath = (base: string, page: PageKey): string => `${base}${pagePaths[page]}`;
const alternateUrl = getPath(alternateBase, activePage);

const navItems: { key: PageKey; label: string; href: string }[] = [
  { key: "home", label: "Home", href: getPath(languageBase, "home") },
  { key: "publications", label: "Publications", href: getPath(languageBase, "publications") },
  { key: "activities", label: "Activities", href: getPath(languageBase, "activities") },
];
const activePageLabel = navItems.find((item) => item.key === activePage)?.label ?? "Home";
const pageTitle = `${activePageLabel} | ${content.siteName}`;
---

<!doctype html>
<html lang={content.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={content.description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/profile.jpg" />
    <link rel="alternate" hreflang={content.language === "ja" ? "en" : "ja"} href={alternateUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="content-panel" aria-label={content.contentLabel}>
        <header class="site-controls">
          <nav class="tabs" aria-label={content.sectionLabel}>
            {
              navItems.map((item) => (
                <a
                  class:list={["tab-link", { active: item.key === activePage }]}
                  href={item.href}
                  aria-current={item.key === activePage ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <a class="language-link" href={alternateUrl}>{content.alternateLabel}</a>
        </header>

        <slot />
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f5f7fa;
    --panel: #ffffff;
    --ink: #111827;
    --muted: #3f4b5a;
    --line: #d7dde5;
    --accent: #2f6f95;
    --accent-dark: #174f72;
    --surface: #f0f3f7;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background:
      linear-gradient(120deg, rgba(63, 126, 166, 0.1), transparent 36%),
      var(--bg);
    color: var(--ink);
  }

  a {
    color: var(--accent-dark);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .page-shell {
    display: grid;
    width: min(1040px, calc(100% - 40px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 40px 0;
    align-items: center;
  }

  .content-panel {
    min-height: 680px;
    padding: 22px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 24px 70px rgba(31, 41, 51, 0.08);
  }

  .site-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: stretch;
    margin-bottom: 42px;
  }

  .tabs {
    display: flex;
    gap: 8px;
    padding: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .tab-link,
  .language-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 700;
    transition:
      background 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .tab-link {
    flex: 1;
    padding: 0 12px;
  }

  .language-link {
    padding: 0 16px;
    border: 1px solid var(--line);
    background: var(--surface);
    white-space: nowrap;
  }

  .tab-link:hover,
  .tab-link.active,
  .language-link:hover {
    background: var(--panel);
    color: var(--ink);
    box-shadow: 0 8px 20px rgba(31, 41, 51, 0.08);
    text-decoration: none;
  }

  .page-content {
    padding: 0 18px 18px;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 30px;
    align-items: start;
  }

  .portrait {
    width: 112px;
    height: 112px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #e5eaf0;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 18px;
    font-size: 2.8rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 18px;
    font-size: 2.25rem;
    line-height: 1;
    letter-spacing: 0;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .publication-item h2,
  .activity-section h2 {
    margin-bottom: 8px;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  p,
  li {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .profile-list {
    display: grid;
    gap: 8px;
    margin-bottom: 0;
    padding-left: 0;
    list-style: none;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    align-items: center;
  }

  .profile-links span {
    color: var(--muted);
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .research-section,
  .bio-section {
    margin-top: 42px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .research-list {
    display: grid;
    gap: 20px;
  }

  .research-topic {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .research-topic:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .research-topic p,
  .bio-content p,
  .publication-item p {
    margin-bottom: 0;
  }

  .bio-timeline {
    position: relative;
    display: grid;
  }

  .bio-timeline::before {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 7px;
    width: 1px;
    background: var(--accent-dark);
    content: "";
  }

  .bio-item {
    position: relative;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 18px;
    padding-bottom: 24px;
  }

  .bio-item:last-child {
    padding-bottom: 0;
  }

  .bio-marker {
    position: relative;
    z-index: 1;
    width: 15px;
    height: 15px;
    margin-top: 5px;
    border: 3px solid var(--panel);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-dark);
  }

  .bio-content {
    position: relative;
    padding-left: 28px;
  }

  .bio-content::before {
    position: absolute;
    top: 12px;
    left: 0;
    width: 18px;
    height: 1px;
    background: var(--accent-dark);
    content: "";
  }

  time {
    color: var(--accent-dark);
    font-weight: 800;
  }

  .publication-groups {
    display: grid;
  }

  .presentation-section {
    margin-top: 42px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .publication-year-group {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .publication-year-group:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .publication-list {
    display: grid;
    gap: 22px;
  }

  .presentation-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 1.15rem;
  }

  .presentation-item {
    color: var(--muted);
  }

  .publication-item p {
    margin-bottom: 6px;
  }

  .publication-author-highlight {
    color: var(--ink);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .presentation-note {
    color: var(--accent-dark);
    font-weight: 800;
  }

  .muted {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .activity-sections {
    display: grid;
    gap: 30px;
  }

  .activity-section {
    display: grid;
    gap: 14px;
  }

  .activity-section h2 {
    margin-bottom: 0;
    color: var(--ink);
    font-size: 1.15rem;
  }

  .activity-table-wrap {
    overflow-x: auto;
    background: transparent;
  }

  .activity-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .activity-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.6;
    text-align: left;
    vertical-align: top;
  }

  .activity-date-column {
    width: 150px;
  }

  .activity-table-three-column .activity-main-column {
    width: 32%;
  }

  .activity-table td:first-child {
    color: var(--accent-dark);
    font-weight: 800;
  }

  .activity-table td:nth-child(2) {
    color: var(--ink);
    font-weight: 700;
  }

  .activity-table tr:last-child td {
    border-bottom: 0;
  }

  @media (max-width: 820px) {
    .page-shell {
      width: min(100% - 28px, 680px);
      min-height: auto;
      padding: 24px 0;
    }

    .content-panel {
      min-height: auto;
      padding: 14px;
    }

    .site-controls {
      grid-template-columns: 1fr;
      margin-bottom: 30px;
    }

    .intro-layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    h1 {
      font-size: 2.8rem;
    }

    h2 {
      font-size: 2.25rem;
    }

    .tabs {
      overflow-x: auto;
    }

    .tab-link {
      min-width: 128px;
    }

    .language-link {
      justify-self: start;
    }

    .page-content {
      padding: 0 8px 12px;
    }

    .activity-table td {
      padding: 12px 10px;
    }

    .activity-date-column {
      width: 96px;
    }
  }

  @media (max-width: 520px) {
    .portrait {
      width: 92px;
      height: 92px;
    }

    h1 {
      font-size: 2.25rem;
    }

    h2 {
      font-size: 1.8rem;
    }

    .tabs {
      gap: 4px;
      padding: 4px;
    }

    .tab-link {
      min-width: 112px;
      font-size: 0.92rem;
    }

    .publication-year-group {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
